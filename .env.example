# Standzeit – Umgebungsvariablen
# Lokal: Werte aus `npx supabase status` übernehmen und als .env.local speichern.

# Öffentlich (landen im Browser – nur unkritische Werte!)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur Server – niemals mit NEXT_PUBLIC_ beginnen lassen
SUPABASE_SECRET_KEY=sb_secret_...
# Schlüsselbund für die Verschlüsselung von Ausweisdaten: "id:base64(32 Byte)", mehrere mit Komma.
# Der letzte Eintrag verschlüsselt neue Daten, ältere bleiben zum Entschlüsseln.
# Neuen Schlüssel erzeugen: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEYS=v1:BITTE_ERSETZEN

# Nur für Tests (direkter DB-Zugriff auf die lokale Datenbank)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MAILPIT_URL=http://127.0.0.1:54324
